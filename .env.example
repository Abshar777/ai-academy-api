# Same database the marketing site writes enrollments to.
MONGODB_URI=mongodb://user:pass@host:27017/
MONGODB_DB=ai_academy

# Signs access tokens and peppers OTP/refresh hashes. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# Shared with the marketing site's ACADEMY_API_SECRET — authenticates the
# server-to-server grant call. Separate from AUTH_SECRET so it can be rotated
# without signing every user out.
INTERNAL_API_SECRET=

PORT=6112
# Comma-separated. The marketing site's origin(s).
ALLOWED_ORIGINS=http://localhost:3000
# Production only — lets the API subdomain and the site share the refresh cookie.
# REQUIRED in production. Without it these cookies are host-only to the API's
# own hostname, so the site at deltaaiacademy.ai cannot read the session hint
# set by api.deltaaiacademy.ai — and a signed-in learner is shown the sign-in
# card again on every reload, with a valid refresh cookie sitting unused.
COOKIE_DOMAIN=.deltaaiacademy.ai

# Sign-in code limits (see src/env.ts). Defaults: 10 per address, 40 per IP,
# per 10 minutes.
# OTP_EMAIL_MAX=10
# OTP_IP_MAX=40
# OTP_WINDOW_MINUTES=10

# Same SMTP account the marketing site sends from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local only: returns the sign-in code in the response so the flow can be
# exercised without a mailbox. Ignored when NODE_ENV=production.
# OTP_ECHO=1

# Cloudflare R2 — the same bucket and credentials the LMS backend uses, so
# both services keep working once public access is switched off.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lms-delta
R2_PUBLIC_URL=https://pub-141ff6250c1340699608dcd12e1c2c92.r2.dev
# Playback URL lifetime in seconds (60-86400). Default 1 hour — the player
# re-mints before it expires, so this is the leaked-link window, not a session
# length.
R2_VIDEO_URL_TTL=3600

# Cloudflare Stream — same account as R2 (account id is reused from
# R2_ACCOUNT_ID). Create a token with Stream:Edit at
# dash.cloudflare.com > My Profile > API Tokens.
CF_STREAM_API_TOKEN=
# Reported by scripts/stream-migrate.ts on the first successful upload.
CF_STREAM_CUSTOMER_CODE=
# Created by scripts/stream-migrate.ts --create-key, printed once.
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=
